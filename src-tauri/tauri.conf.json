{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Unified Control",
  "mainBinaryName": "UnifiedControl",
  "version": "0.0.0",
  "identifier": "com.oldbugo.unifiedcontrol",
  "build": {
    "frontendDist": "../public"
  },
  "app": {
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"],
    "shortDescription": "One tray app for your devices",
    "copyright": "Private",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false,
        "installerHooks": "installer-hooks.nsh"
      }
    }
  }
}
