{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Unified Control",
  "mainBinaryName": "UnifiedControl",
  "version": "0.25.0",
  "identifier": "com.oldbugo.unifiedcontrol",
  "build": {
    "beforeBuildCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-resources.ps1",
    "frontendDist": "../public"
  },
  "app": {
    "windows": [],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data: http://127.0.0.1:* https:; media-src 'self' blob: data: http://127.0.0.1:* https:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* https:; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"],
    "shortDescription": "One tray app for your devices",
    "copyright": "Private",
    "resources": {
      "resources/monitor/": "monitor/",
      "runtime/usage-reader/": "usage-reader/",
      "runtime/node/": "node/",
      "runtime/agent-mcp/": "agent-mcp/",
      "runtime/cooler/": "cooler/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false,
        "installerHooks": "installer-hooks.nsh"
      }
    }
  }
}
